+++ b/research/level4/handoff/PR.md
@@ -0,0 +1,45 @@
+# feat: certify the full Level 4 solver and general-level move counts
+
+Level 4 previously had no solver, and the headless model generated no cubies
+at research-only rendering tiers. This change materializes the mechanics state
+independently of rendering and adds `level4-slice-reduction` for all 160,000
+cells and the complete 44,784-atom standard move set.
+
+The solver normalizes the 66-dimensional orbit-parity vector, places cells on
+all 3,050 independent orbits using certified pure 3-cycles and complete
+ordered-pair BFS, and finishes C3 twists, D4 flips and independent rolls.
+Every output atom is replayed on the sparse integer state before success.
+Exhaustive atom comparison connects this simulator to the original engine.
+The desktop Lab runs scramble, solve and benchmark work in workers and shows
+Level 4 numerical results without materializing a 3D scene or playback history.
+
+The accompanying computation establishes the exact group order
+`log10 |G4| = 244936.58485676695…` and the certified interval
+**52,662 ≤ G4 ≤ 23,645,070** in the target-turn metric. A separate geometric
+count derives exact legal-target formulas for arbitrary level n and the
+unconditional bound `G_n = Omega(20^n/n)`. Proofs, complete word data, the
+3,050-row orbit catalogue and reproducible experiment records are included.
+
+Validation:
+
+- All workspace typechecks and the Lab production build pass.
+- Level 4: six regression tests pass, including full engine endpoints and
+  rejection of lone twists/flips and malformed states.
+- Existing Level 3: all five completeness regression tests pass.
+- All 6,631,848 legal selected-site transitions and 44,784 rotation deltas
+  agree with the original engine functions.
+- Every orbit's independent alternating subgroup and pair transport is
+  certified; the complete pair tables cover 23,099,392 states.
+- Full-generator seeded solves at lengths 5, 20 and 100 pass raw replay.
+- A direct invariant-state construction disrupting every orbit also solves.
+- General-level formula checks match engine censuses through Level 4 and
+  independent boundary enumeration through Level 5.
+
+Reproduce with `npm run prove:l4`, `npm run verify:l4`, `npm run test:l4`,
+`npm run verify:l4:synthetic`, and the commands in `research/level4/README.md`.
+
+Solutions are not optimal and can contain millions of moves. Large-word
+verification uses sparse integer replay supported by exhaustive engine atom
+comparison; targeted tests additionally perform full 160,000-cell engine
+replay. Recorded Node runs use roughly 1–2 GB. The small timing sample is not
+a controlled performance comparison or a literature novelty claim.
diff --git a/research/level4/level-n-formula.ts b/research/level4/level-n-formula.ts
new file mode 100644
index 0000000..9fee0bb
--- /dev/null
+++ b/research/level4/level-n-formula.ts
@@ -0,0 +1,60 @@
+import { mkdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { createPuzzleConfig, isMengerCell } from '../../packages/engine/src/generateMenger';
+
+/** Exact for the standard frame/block/slab move system, n >= 1. */
+export const legalCellRollTargets = (n: number): bigint => {
+  if (!Number.isSafeInteger(n) || n < 1) throw new Error('Level must be a positive integer');
+  return (100n * 20n ** BigInt(n - 1) + 272n * 8n ** BigInt(n - 1) + 648n * 3n ** BigInt(n - 1)) / 85n;
+};
+export const legalMoveAtoms = (n: number): bigint => {
+  const frames = 9n * (3n ** BigInt(n) - 1n) / 2n;
+  let coarserRolls = 0n;
+  for (let d = 1; d < n; d++) coarserRolls += legalCellRollTargets(d);
+  return 3n * (frames + legalCellRollTargets(n) + 4n * coarserRolls);
+};
+
+const rows = [];
+for (let n = 1; n <= 10; n++) {
+  const rolls = legalCellRollTargets(n); const atoms = legalMoveAtoms(n);
+  if (n <= 5) {
+    // Independent geometric enumeration of A_(n-1): a site with both its
+    // negative Y and negative Z neighbours missing. Symmetry gives R_n=12A.
+    let A = 0;
+    if (n === 1) A = 1;
+    else {
+      const c = createPuzzleConfig(n - 1);
+      const occupied = (x: number, y: number, z: number): boolean =>
+        Math.abs(x) <= c.extent && Math.abs(y) <= c.extent && Math.abs(z) <= c.extent && isMengerCell([x, y, z], c);
+      for (const x of c.coordinates) for (const y of c.coordinates) for (const z of c.coordinates) {
+        if (occupied(x, y, z) && !occupied(x, y - 1, z) && !occupied(x, y, z - 1)) A++;
+      }
+    }
+    if (rolls !== 12n * BigInt(A)) throw new Error(`Direct boundary enumeration differs at n=${n}`);
+  }
+  if (n <= 4) {
+    const census = JSON.parse(readFileSync(`research/level4/out/census-L${n}.json`, 'utf8'));
+    if (atoms !== BigInt(census.legalAtoms)) throw new Error(`Engine census differs at n=${n}`);
+    for (let d = 1; d <= n; d++) {
+      if (BigInt(census.families[`ext-d${d}`].atoms) !== 3n * legalCellRollTargets(d)) throw new Error('Block depth census differs');
+      if (d < n && BigInt(census.families[`ext-d${d + 0.5}`].atoms) !== 9n * legalCellRollTargets(d)) throw new Error('Slab depth census differs');
+    }
+  }
+  let rollOnlyGodsLowerBound: number | undefined;
+  if (n <= 5) {
+    const states = 4n ** rolls;
+    let d = Math.ceil(Number(rolls) * Math.log10(4) / Math.log10(Number(atoms)));
+    const ball = (r: number): bigint => (atoms ** BigInt(r + 1) - 1n) / (atoms - 1n);
+    while (d > 0 && ball(d - 1) >= states) d--;
+    while (ball(d) < states) d++;
+    rollOnlyGodsLowerBound = d;
+  }
+  rows.push({ level: n, cells: (20n ** BigInt(n)).toString(), independentCellRollTargets: rolls.toString(), legalAtoms: atoms.toString(), rollOnlyGodsLowerBound });
+}
+mkdirSync('research/level4/out', { recursive: true });
+writeFileSync('research/level4/out/level-n-formula.json', JSON.stringify({
+  formula: 'R_n = (100*20^(n-1) + 272*8^(n-1) + 648*3^(n-1))/85',
+  atomFormula: 'M_n = 3*(9*(3^n-1)/2 + R_n + 4*sum_(d=1)^(n-1) R_d)',
+  directBoundaryEnumerationThroughLevel: 5, engineCensusAgreementThroughLevel: 4,
+  theorem: 'G_n = Omega(20^n/n), from the independent subgroup C4^(R_n) and the exact move alphabet M_n', rows,
+}, null, 2) + '\n');
+console.log(JSON.stringify(rows, null, 2));
diff --git a/research/level4/orientation-tools.ts b/research/level4/orientation-tools.ts
new file mode 100644
index 0000000..1b304d5
--- /dev/null
+++ b/research/level4/orientation-tools.ts
@@ -0,0 +1,74 @@
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { createSparseGroup, fullAction, inverseAtom, inverseWord, orientationFrames, ROT_ID, rotInv, rotMul } from '../../packages/solver-core/src/algorithms/mengerSparseGroup';
+import { actionKey, alphabetFor, composeActions, conjugateAction, inverseAction, permutationKey, simplifyWord, type Tool } from './tools';
+
+const level = Number(process.argv.find((a) => a.startsWith('--level='))?.split('=')[1] ?? 4);
+const group = createSparseGroup(level, console.log);
+const frames = orientationFrames(group);
+const records = new Map<number, string[]>();
+for (const file of [`research/level4/out/tools-L${level}.json`, `research/level4/out/seed-tools-L${level}.json`]) {
+  if (existsSync(file)) for (const r of JSON.parse(readFileSync(file, 'utf8')).tools) records.set(r.orbit, r.word);
+}
+const out: Array<{ orbit: number; kind: 'C3' | 'D4'; word: string[] }> = [];
+for (const [orbit, frame] of frames.entries()) {
+  const order = frame.freedom.length;
+  if (order !== 3 && order !== 8) continue;
+  const kind = order === 3 ? 'C3' : 'D4';
+  console.log(`${kind} orbit=${orbit} size=${group.orbits[orbit]!.length} base=${group.sites[group.orbits[orbit]![0]!]}`);
+  const ids = records.get(orbit);
+  if (!ids) { console.log('No position tool yet'); continue; }
+  const baseWord = ids.map((id) => group.atomById.get(id)!);
+  const base = { word: baseWord, action: fullAction(baseWord) };
+  const alphabet = alphabetFor(group, orbit, true);
+  const rotOrder = (r: number): number => { let x = r; let k = 1; while (x !== ROT_ID) { x = rotMul[r]![x]!; k++; } return k; };
+  const quarter = frame.freedom.find((r) => rotOrder(r) === 4);
+  const cyclic = quarter === undefined ? new Set(frame.freedom) : new Set([ROT_ID, quarter, rotMul[quarter]![quarter]!, rotInv[quarter]!]);
+  const isFlip = (site: number, r: number): boolean => !cyclic.has(rotMul[rotInv[frame.ref[site]!]!]![rotMul[r]![frame.ref[site]!]!]!);
+  const byPosition = new Map<string, Tool[]>();
+  const seen = new Set<string>(); const queue: Tool[] = [];
+  let answer: Tool | null = null;
+  const record = (candidate: Tool): void => {
+    const key = actionKey(candidate.action);
+    if (seen.has(key)) return;
+    seen.add(key);
+    const pkey = permutationKey(candidate.action);
+    const prior = byPosition.get(pkey) ?? [];
+    for (const other of prior) {
+      let action = composeActions(candidate.action, inverseAction(other.action));
+      if (![...action].every(([s, [t]]) => s === t && group.orbitOf[s] === orbit)) continue;
+      let word = [...candidate.word, ...inverseWord(group, other.word)];
+      if (kind === 'D4') {
+        if ([...action].filter(([s, [, r]]) => isFlip(s, r)).length !== 2) continue;
+        // Remove any third-cell quarter rotation so the word is supported on exactly two cells.
+        for (const [s, [, r]] of action) {
+          if (isFlip(s, r)) continue;
+          const roll = group.atomsAt[s]!.map((i) => group.atoms[i]!).find((a) => a.map.size === 1 && rotMul[a.rot]![r] === ROT_ID);
+          if (!roll) throw new Error(`No roll clears stationary rotation at ${s}`);
+          word.push(roll);
+        }
+        action = fullAction(word);
+      }
+      if (action.size !== 2) continue;
+      answer = { word: simplifyWord(group, word), action };
+      return;
+    }
+    prior.push(candidate); byPosition.set(pkey, prior); queue.push(candidate);
+  };
+  record(base);
+  for (let head = 0; head < queue.length && !answer && head < 200000; head++) {
+    const from = queue[head]!;
+    for (const a of alphabet) {
+      record({ word: [a, ...from.word, inverseAtom(group, a)], action: conjugateAction(group, from.action, a) });
+      if (answer) break;
+    }
+    if (head > 0 && head % 10000 === 0) console.log(`  ${head} variants explored, ${queue.length} queued`);
+  }
+  if (!answer) { console.log(`OPEN ${kind} orbit=${orbit}, ${queue.length} variants`); continue; }
+  const tool = answer as Tool;
+  const checked = fullAction(tool.word);
+  if (actionKey(checked) !== actionKey(tool.action)) throw new Error('Word/action mismatch');
+  out.push({ orbit, kind, word: tool.word.map((a) => a.id) });
+  console.log(`FOUND ${kind} orbit=${orbit}: ${tool.word.length} atoms, ${actionKey(checked)}`);
+}
+mkdirSync('research/level4/out', { recursive: true });
+writeFileSync(`research/level4/out/orientation-tools-L${level}.json`, JSON.stringify({ level, tools: out }) + '\n');
