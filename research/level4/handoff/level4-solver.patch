+    const sites = group.orbits[orbit]!;
+    if (sites.every((s) => state.siteOf[s] === s)) continue;
+    const tool = tools.get(orbit)!;
+    if (sites.length >= 384) progress?.(`Building tuple transport for orbit ${orbit}, size ${sites.length}`);
